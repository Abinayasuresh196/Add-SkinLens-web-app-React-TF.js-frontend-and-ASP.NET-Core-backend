  "prediction_steps": [
    "probs = model.predict(image)  // 7 softmax values",
    "adjusted[i] = probs[i] * decision_multiplier[i]",
    "adjusted = adjusted / sum(adjusted)",
    "predicted_class = argmax(adjusted)"
